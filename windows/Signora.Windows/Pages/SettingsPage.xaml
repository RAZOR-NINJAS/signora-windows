<Page
    x:Class="Signora.Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <Grid Margin="28">
            <StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Left">

                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{StaticResource SignoraTitleStyle}" />
                    <TextBlock Text="Changes apply the next time a Live session starts."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Recognition" Style="{StaticResource SignoraCaptionStyle}" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Default mode" />
                                <TextBlock Text="ISL uses both hands and body anchors; ASL is one-hand fingerspelling."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="ModeBox" Grid.Column="1" Width="180" VerticalAlignment="Center"
                                      SelectionChanged="ModeBox_SelectionChanged">
                                <ComboBoxItem Content="ISL" Tag="isl" />
                                <ComboBoxItem Content="ASL" Tag="asl" />
                                <ComboBoxItem Content="Body" Tag="body" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Quality profile" />
                                <TextBlock Text="High uses BlazePose Full and 960 px hand inference."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="QualityBox" Grid.Column="1" Width="180" VerticalAlignment="Center"
                                      SelectionChanged="QualityBox_SelectionChanged">
                                <ComboBoxItem Content="High" Tag="high" />
                                <ComboBoxItem Content="Balanced" Tag="balanced" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Camera" />
                                <TextBlock Text="DirectShow camera index. Try 1 or 2 for an external webcam."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <NumberBox x:Name="CameraBox" Grid.Column="1" Width="120" Minimum="0" Maximum="8"
                                       SpinButtonPlacementMode="Compact" VerticalAlignment="Center"
                                       ValueChanged="CameraBox_ValueChanged" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Dwell to confirm" />
                                <TextBlock x:Name="DwellValueText" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Slider x:Name="DwellSlider" Grid.Column="1" Width="280" Minimum="150" Maximum="1500"
                                    StepFrequency="50" VerticalAlignment="Center"
                                    ValueChanged="DwellSlider_ValueChanged" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Confidence threshold" />
                                <TextBlock x:Name="ThresholdValueText" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Slider x:Name="ThresholdSlider" Grid.Column="1" Width="280" Minimum="0.30" Maximum="0.90"
                                    StepFrequency="0.01" VerticalAlignment="Center"
                                    ValueChanged="ThresholdSlider_ValueChanged" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Mirror camera" />
                                <TextBlock Text="Matches the preview to a mirror; recommended for signing."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="MirrorSwitch" Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="On" OffContent="Off" Toggled="MirrorSwitch_Toggled" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Speech feedback" />
                                <TextBlock Text="Speak confirmed signs with the offline Piper voice."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TtsSwitch" Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="On" OffContent="Off" Toggled="TtsSwitch_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Engine" Style="{StaticResource SignoraCaptionStyle}" />
                        <TextBlock x:Name="EnginePathText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <TextBlock x:Name="RootPathText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <TextBlock x:Name="DataPathText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                            <Button Content="Reset to defaults" Click="Reset_Click" />
                            <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
