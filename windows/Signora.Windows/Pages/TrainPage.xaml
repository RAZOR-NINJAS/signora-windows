<Page
    x:Class="Signora.Windows.Pages.TrainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <Grid Margin="28">
            <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">

                <StackPanel Spacing="4">
                    <TextBlock Text="Train" Style="{StaticResource SignoraTitleStyle}" />
                    <TextBlock Text="Import new samples and retrain the ISL spatial model without leaving the app."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Training data" Style="{StaticResource SignoraCaptionStyle}" />
                        <TextBlock x:Name="DataPathText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="ClassCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ImportButton" Content="Import .npy samples"
                                    Click="ImportButton_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Open data folder" Click="OpenFolder_Click" />
                            <Button Content="Refresh" Click="Refresh_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Retrain model" Style="{StaticResource SignoraCaptionStyle}" />
                        <TextBlock Text="Rebuilds the 220-dimensional ISL spatial classifier from every .npy class in the data folder."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Exclude labels (comma separated)" FontSize="12" />
                                <TextBox x:Name="ExcludeBox" Text="SUII_MOTION"
                                         PlaceholderText="SUII_MOTION" />
                            </StackPanel>
                            <Button x:Name="RetrainButton" Grid.Column="1" Content="Retrain"
                                    Click="RetrainButton_Click" VerticalAlignment="Bottom"
                                    Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="TrainingRing" IsActive="False" Width="20" Height="20" />
                            <TextBlock x:Name="TrainingStatusText" Text="Idle"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" FontFamily="Consolas" Height="280"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
